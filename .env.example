# Copy to .env and adjust. Never commit the real .env file.
# Docker Compose and the local backend both read this file.
# Keep comments on their own lines: a trailing comment after an empty value
# would be read as the value.

# ---- Application ----
# development | test | production
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# ---- Database ----
# Used by the backend when running locally (outside Docker).
DATABASE_URL=postgresql+psycopg://portfolioai:portfolioai@localhost:5432/portfolioai
# Used by Docker Compose to create the database container.
POSTGRES_USER=portfolioai
POSTGRES_PASSWORD=portfolioai
POSTGRES_DB=portfolioai

# ---- Security ----
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required (32+ characters) when ENVIRONMENT=production.
JWT_SECRET=change-me-in-development-only
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- AI provider (needed from phase 7) ----
# gemini | openai
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional. Leave empty to use the provider default.
LLM_MODEL=

# ---- Embeddings and vector store ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# pgvector | chroma | faiss
VECTOR_STORE=pgvector
# Only for external stores such as a Chroma server. Leave empty otherwise.
VECTOR_DB_URL=

# ---- Uploads ----
MAX_UPLOAD_MB=10
